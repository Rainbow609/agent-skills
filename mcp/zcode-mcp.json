{
  "servers": {
    "memorix": {
      "command": "/opt/homebrew/bin/memorix",
      "args": [
        "serve"
      ],
      "env": {
        "MEMORIX_ORAMA_HYDRATION_THRESHOLD": "100"
      }
    },
    "dbx": {
      "command": "/opt/homebrew/bin/dbx-mcp-server",
      "args": []
    },
    "context7": {
      "command": "/opt/homebrew/bin/context7-mcp",
      "args": []
    },
    "everos-memory": {
      "command": "uvx",
      "args": [
        "everos-mcp"
      ],
      "env": {
        "EVEROS_BASE_URL": "http://127.0.0.1:8000",
        "EVEROS_USER_ID": "manbo-reader"
      },
      "timeoutMs": 180000
    }
  }
}
